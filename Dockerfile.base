FROM opensuse/tumbleweed

ARG NODE_VERSION=26
ARG KUBECTL_VERSION=v1.31
ARG PLAYWRIGHT_VERSION=1.61.0
ARG TRAFILATURA_VERSION=2.1.0

RUN zypper --non-interactive refresh \
    && zypper --non-interactive dup \
    && zypper --non-interactive install --no-recommends \
        tini nodejs${NODE_VERSION} npm${NODE_VERSION} python3 python3-pipx go gcc-c++ fd ripgrep jq yq bc zip unzip git vim tmux make diff \
        chromium qt6-wayland wl-clipboard \
        terminfo \
        man man-pages \
        ca-certificates curl \
    && ln -sf /usr/bin/python3 /usr/bin/python

ENV EDITOR=vim
ENV NODE_PATH=/usr/local/lib/node_modules:/usr/lib/node_modules
ENV PIPX_HOME=/opt/pipx PIPX_BIN_DIR=/usr/local/bin

# dotnet repo
RUN rpm --import https://packages.microsoft.com/keys/microsoft.asc \
    && rpm --import https://packages.microsoft.com/keys/microsoft-2025.asc \
    && zypper addrepo --refresh https://packages.microsoft.com/config/opensuse/16/prod.repo

# playwright
RUN --mount=type=secret,id=npmrc,target=/root/.npmrc \
    npm install -g patchright@${PLAYWRIGHT_VERSION}

# trafilatura
RUN pipx install trafilatura==${TRAFILATURA_VERSION}

# kubectl repo (kubectl itself is installed at runtime via --unsafe-enable-kube)
RUN zypper addrepo --refresh "https://pkgs.k8s.io/core:/stable:/${KUBECTL_VERSION}/rpm/" kubernetes

# cleanup
RUN zypper --non-interactive remove -y --clean-deps sudo openssh openssh-clients || true \
    && zypper clean --all

COPY common/image_AGENTS.md /AGENTS.md
COPY common/entrypoint.sh /entrypoint.sh
COPY common/chromium /usr/local/bin/chromium
COPY common/chrome-policies/pibox.json /etc/chromium/policies/managed/pibox.json

WORKDIR /

ENTRYPOINT ["/usr/sbin/tini", "--", "/entrypoint.sh"]
