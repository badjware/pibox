FROM archlinux:latest

ARG CAMOUFOX_VERSION=0.5.9
ARG TRAFILATURA_VERSION=2.4.0
ARG GCX_VERSION=1.8.0

RUN pacman -Syu --noconfirm --needed \
        nodejs npm python python-pipx python-filelock go gcc fd ripgrep jq yq bc zip unzip git vim tmux make diffutils \
        gtk3 dbus-glib libxt nss alsa-lib wl-clipboard \
        ncurses \
        ca-certificates curl \
        docker docker-compose docker-buildx \
        iproute2 containerd iptables \
        kubectl aws-cli-v2

ENV EDITOR=vim
# camoufox/node_modules exposes the playwright-core copy that camoufox ships
ENV NODE_PATH=/usr/local/lib/node_modules:/usr/lib/node_modules:/usr/lib/node_modules/camoufox/node_modules
ENV PIPX_HOME=/opt/pipx PIPX_BIN_DIR=/usr/local/bin
# no Secret Service in the container
ENV GCX_KEYCHAIN=off

# camoufox: the browser ships in the image, so it matches CAMOUFOX_VERSION;
# the GeoIP database downloads to ~/.cache/camoufox on first use
ENV CAMOUFOX_EXECUTABLE_PATH=/opt/camoufox/browser/camoufox-bin CAMOUFOX_FPGEN_DATA=/opt/camoufox/fpgen
RUN --mount=type=secret,id=npmrc,target=/root/.npmrc \
    npm install -g camoufox@${CAMOUFOX_VERSION} \
    && XDG_CACHE_HOME=/opt camoufox fetch \
    && ln -s /opt/camoufox/browsers/official/* /opt/camoufox/browser \
    && rm -rf /opt/camoufox/geoip

# chromium: driven by the playwright-core copy that camoufox ships,
# so the browser matches its Playwright version
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/playwright
RUN node /usr/lib/node_modules/camoufox/node_modules/playwright-core/cli.js install chromium

# trafilatura
RUN pipx install trafilatura==${TRAFILATURA_VERSION}

# gcx (Grafana CLI)
RUN GOPATH=/tmp/go GOBIN=/usr/local/bin go install github.com/grafana/gcx/cmd/gcx@v${GCX_VERSION} \
    && rm -rf /tmp/go /root/.cache/go-build

# cleanup
RUN pacman -Rns --noconfirm sudo openssh 2>/dev/null || true \
    && pacman -Scc --noconfirm

COPY common/image_AGENTS.md /AGENTS.md
COPY common/entrypoint.sh /entrypoint.sh

WORKDIR /

# launch.py runs the container with --init
ENTRYPOINT ["/entrypoint.sh"]
