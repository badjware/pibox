# Build AUR packages in a throwaway stage (makepkg refuses to run as root).
FROM archlinux:latest AS aur
RUN pacman -Syu --noconfirm --needed base-devel git \
    && useradd -m builder \
    && echo 'builder ALL=(ALL) NOPASSWD: ALL' >> /etc/sudoers

USER builder
WORKDIR /home/builder

RUN for pkg in tini docker-rootless-extras; do \
        git clone https://aur.archlinux.org/$pkg.git \
        && ( cd $pkg && PKGEXT=.pkg.tar.zst makepkg -s --noconfirm ); \
    done \
    && mkdir /tmp/pkgs \
    && cp $(find . -name '*.pkg.tar.zst' | grep -v debug) /tmp/pkgs/

FROM archlinux:latest

ARG PLAYWRIGHT_VERSION=1.61.0
ARG TRAFILATURA_VERSION=2.1.0

RUN pacman -Syu --noconfirm --needed \
        nodejs npm python python-pipx go gcc fd ripgrep jq yq bc zip unzip git vim tmux make diffutils \
        chromium qt6-wayland wl-clipboard \
        ncurses \
        ca-certificates curl \
        docker docker-compose docker-buildx \
        fuse-overlayfs slirp4netns rootlesskit iproute2 containerd iptables \
        kubectl aws-cli-v2

# tini and docker-rootless-extras (built in the aur stage above)
COPY --from=aur /tmp/pkgs /tmp/pkgs
RUN pacman -U --noconfirm /tmp/pkgs/*.pkg.tar.zst && rm -rf /tmp/pkgs

ENV EDITOR=vim
ENV NODE_PATH=/usr/local/lib/node_modules:/usr/lib/node_modules
ENV PIPX_HOME=/opt/pipx PIPX_BIN_DIR=/usr/local/bin

# playwright
RUN --mount=type=secret,id=npmrc,target=/root/.npmrc \
    npm install -g patchright@${PLAYWRIGHT_VERSION}

# trafilatura
RUN pipx install trafilatura==${TRAFILATURA_VERSION}

# cleanup
RUN pacman -Rns --noconfirm sudo openssh 2>/dev/null || true \
    && pacman -Scc --noconfirm

COPY common/image_AGENTS.md /AGENTS.md
COPY common/entrypoint.sh /entrypoint.sh
COPY common/chromium /usr/local/bin/chromium
COPY common/chrome-policies/pibox.json /etc/chromium/policies/managed/pibox.json

WORKDIR /

ENTRYPOINT ["/usr/bin/tini", "--", "/entrypoint.sh"]
