#compdef pibox claudebox nanobox launch.py

_pibox() {
    _arguments -S \
        '--help[show help text and exit]' \
        '--build[build images locally instead of pulling]' \
        '--pull[pull latest image before launch]' \
        '--harness[agent to run]:harness:(pi claude pi-web)' \
        '--read-only[mount the workdir read-only]' \
        '*--volume[bind-mount an extra volume]:volume:_files' \
        '*--env[set an environment variable in the container]:variable:_parameters -g "*export*"' \
        '*--extra-package[install an extra pacman or AUR package at startup]:package:' \
        '*--port[publish a container port (Docker -p syntax)]:port:' \
        '--unsafe-enable-docker[enable rootless Docker-in-Docker (privileged)]' \
        '--unsafe-enable-aws[mount ~/.aws into the container]' \
        '--unsafe-enable-kube[mount ~/.kube into the container]' \
        '--unsafe-enable-gcx[mount ~/.config/gcx into the container]' \
        '--unsafe-host-wayland[mount the Wayland socket into the container]' \
        '--unsafe-host-net[share the host network namespace]' \
        '(-)--[forward remaining args to the agent]:: :_default'
}

_pibox "$@"
