[Unit]
Description=pibox pi-web sandbox
Wants=openshell-gateway.service
After=openshell-gateway.service

[Service]
Environment=PIBOX_PI_WEB_PORT=18504
WorkingDirectory=%h/develop
ExecStart=%h/.local/bin/pibox --read-only --harness pi-web
# the image build and the sandbox start take a while, and the port forward
# only answers once pi-web listens, so probe readiness
ExecStartPost=/bin/bash -c 'until curl -s -o /dev/null http://127.0.0.1:$PIBOX_PI_WEB_PORT/; do sleep 0.5; done'
TimeoutStartSec=300
